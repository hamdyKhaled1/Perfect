<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Perfect | بيرفكت</title>
    <link rel="icon" type="image/jpeg" href="~/images/perfect-logo.jpg" />

    <!-- Google Fonts: Noto Sans Arabic -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@300..900&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 RTL -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Clients" asp-action="Index">
                <img src="~/images/perfect-logo.jpg" alt="Perfect - بيرفكت" class="brand-logo" />
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Clients" asp-action="Index">
                            <i class="fas fa-home me-1"></i> الرئيسية
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Capital" asp-action="Index">
                            <i class="fas fa-chart-line me-1"></i> رأس مال الشركة
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Clients" asp-action="Create">
                            <i class="fas fa-user-plus me-1"></i> عميل جديد
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Outside" asp-action="Index">
                            <i class="fas fa-right-left me-1"></i> الخارج
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="StripInventory" asp-action="Index">
                            <i class="fas fa-boxes-stacked me-1"></i> مخزون الاستربس
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Transactions" asp-action="FarmMeals">
                            <i class="fas fa-box-archive me-1"></i> أرشيف الوجبات
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Treasury" asp-action="Index">
                            <i class="fas fa-vault me-1"></i> الخزن
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Expenses" asp-action="Index">
                            <i class="fas fa-money-bill-transfer me-1"></i> المصروفات
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container my-4">
        <!-- Success/Error Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
                <i class="fas fa-check-circle me-2"></i>
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white text-center py-3 mt-auto">
        <div class="container">
            <p class="mb-0">
                Perfect | بيرفكت &copy; @DateTime.Now.Year
            </p>
        </div>
    </footer>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
