@model HagImamAccounts.ViewModels.FarmMealEditViewModel
@{
    ViewData["Title"] = "تعديل بيانات الوجبة";
}

<div class="fade-in">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4 text-warning">
                        <i class="fas fa-edit me-2"></i>تعديل بيانات الوجبة
                    </h4>

                    <form asp-action="EditFarmMeal" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input asp-for="Id" type="hidden" />
                        <input asp-for="ReturnPage" type="hidden" />
                        <input asp-for="ReturnPageSize" type="hidden" />
                        <input asp-for="ReturnFarmName" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="Date" class="form-label">تاريخ الوجبة</label>
                            <input asp-for="Date" type="date" class="form-control" />
                            <span asp-validation-for="Date" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FarmName" class="form-label">اسم المزرعة</label>
                            <input asp-for="FarmName" class="form-control" maxlength="200" />
                            <span asp-validation-for="FarmName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FarmPrice" class="form-label">سعر المزرعة</label>
                            <input asp-for="FarmPrice" type="number" min="0" step="0.01" class="form-control" />
                            <span asp-validation-for="FarmPrice" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="FarmWeight" class="form-label">وزن المزرعة</label>
                            <input asp-for="FarmWeight" type="number" min="0" step="0.01" class="form-control" />
                            <span asp-validation-for="FarmWeight" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-warning px-4">
                                <i class="fas fa-save me-1"></i> حفظ التعديلات
                            </button>
                            <a asp-action="FarmMeals" asp-route-page="@Model.ReturnPage"
                               asp-route-pageSize="@Model.ReturnPageSize" asp-route-farmName="@Model.ReturnFarmName"
                               class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i> إلغاء
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
