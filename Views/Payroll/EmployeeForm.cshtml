@model Employee
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "موظف جديد" : "تعديل موظف";
}

<div class="fade-in">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="fas @(isNew ? "fa-user-plus" : "fa-user-pen") me-2 text-success"></i>
                @(isNew ? "إضافة موظف جديد" : $"تعديل بيانات {Model.Name}")
            </h3>
            <div class="text-muted">بيانات الموظف والراتب الشهري الأساسي.</div>
        </div>
        <a asp-action="Employees" class="btn btn-outline-dark">
            <i class="fas fa-arrow-right me-1"></i> رجوع للموظفين
        </a>
    </div>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="@(isNew ? "CreateEmployee" : "EditEmployee")" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />

                <div class="row g-3">
                    <div class="col-md-6 col-lg-4">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" maxlength="200" autocomplete="off" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <label asp-for="JobTitle" class="form-label"></label>
                        <input asp-for="JobTitle" class="form-control" maxlength="100" autocomplete="off" />
                        <span asp-validation-for="JobTitle" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" maxlength="20" dir="ltr" autocomplete="off" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <label asp-for="MonthlySalary" class="form-label"></label>
                        <input asp-for="MonthlySalary" type="number" min="0" step="0.0001" class="form-control" />
                        <span asp-validation-for="MonthlySalary" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <label asp-for="HireDate" class="form-label"></label>
                        <input asp-for="HireDate" type="date" class="form-control"
                               value="@Model.HireDate.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="HireDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 col-lg-4 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="2" maxlength="1000"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="fas fa-save me-1"></i> حفظ
                    </button>
                    <a asp-action="Employees" class="btn btn-outline-secondary">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>
