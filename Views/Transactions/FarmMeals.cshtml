@model HagImamAccounts.ViewModels.FarmMealArchiveViewModel
@{
    ViewData["Title"] = "أرشيف الوجبات";
}

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">
            <i class="fas fa-box-archive me-2 text-success"></i>أرشيف الوجبات الموزعة
        </h4>
        <a asp-action="BulkMeal" class="btn btn-success">
            <i class="fas fa-plus me-1"></i> إدخال وجبات
        </a>
    </div>

    <form asp-action="FarmMeals" method="get" class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label for="farmName" class="form-label">فلترة باسم المزرعة</label>
                    <input id="farmName" name="farmName" type="search" class="form-control"
                           value="@Model.FarmName" placeholder="اكتب اسم المزرعة..." />
                    <input type="hidden" name="page" value="1" />
                    <label for="farmMealPageSize" class="form-label mt-2">الوجبات بالصفحة</label>
                    <select id="farmMealPageSize" name="pageSize" class="form-select" onchange="this.form.requestSubmit()">
                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                        <option value="25" selected="@(Model.PageSize == 25)">25</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-success">
                        <i class="fas fa-search me-1"></i> بحث
                    </button>
                    <a asp-action="FarmMeals" class="btn btn-outline-secondary">عرض الكل</a>
                </div>
            </div>
        </div>
    </form>

    @if (Model.Batches.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center text-muted py-5">
                <i class="fas fa-inbox fa-2x mb-3"></i>
                <p class="mb-0">
                    @(string.IsNullOrEmpty(Model.FarmName)
                        ? "لا توجد وجبات محفوظة حتى الآن."
                        : "لا توجد وجبات محفوظة باسم المزرعة المطلوب.")
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>التاريخ</th>
                        <th>اسم المزرعة</th>
                        <th>سعر الكيلو</th>
                        <th>عدد العملاء</th>
                        <th>وزن المزرعة</th>
                        <th>حساب المزرعة</th>
                        <th>الأرباح</th>
                        <th>التفاصيل</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var index = 0; index < Model.Batches.Count; index++)
                    {
                        var batch = Model.Batches[index];
                        <tr>
                            <td class="text-nowrap">@batch.Date.ToString("dd/MM/yyyy")</td>
                            <td>@(string.IsNullOrWhiteSpace(batch.FarmName) ? "—" : batch.FarmName)</td>
                            <td>@batch.FarmPrice.ToString("#,##0.####")</td>
                            <td>@batch.Transactions.Count</td>
                            <td>@batch.FarmWeight.ToString("#,##0.####")</td>
                            <td>@batch.FarmAccount.ToString("#,##0.####")</td>
                            <td class="fw-bold">@batch.Profit.ToString("#,##0.####")</td>
                            <td>
                                <a asp-action="FarmMealDetails" asp-route-id="@batch.Id" class="btn btn-sm btn-outline-success">
                                    <i class="fas fa-eye me-1"></i> عرض التوزيع
                                </a>
                            </td>
                            <td class="text-nowrap">
                                <a asp-action="EditFarmMeal" asp-route-id="@batch.Id"
                                   asp-route-page="@Model.Page" asp-route-pageSize="@Model.PageSize"
                                   asp-route-farmName="@Model.FarmName"
                                   class="btn btn-sm btn-warning" title="تعديل بيانات الوجبة">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="DeleteFarmMeal" asp-route-id="@batch.Id" method="post"
                                      data-confirm="هل أنت متأكد من حذف وجبة مزرعة '@batch.FarmName' بتاريخ @batch.Date.ToString("dd/MM/yyyy")؟ سيتم إخفاء وجبات العملاء المرتبطة بها وحذف تسجيل أرباحها."
                                      class="d-inline">
                                    <input type="hidden" name="page" value="@Model.Page" />
                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                    <input type="hidden" name="farmName" value="@Model.FarmName" />
                                    <button type="submit" class="btn btn-sm btn-danger" title="حذف الوجبة">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            var firstPage = Math.Max(1, Model.Page - 2);
            var lastPage = Math.Min(Model.TotalPages, firstPage + 4);
            firstPage = Math.Max(1, lastPage - 4);
            <nav class="mt-3" aria-label="التنقل بين صفحات أرشيف الوجبات">
                <ul class="pagination justify-content-center flex-wrap">
                    <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="FarmMeals" asp-route-page="1"
                           asp-route-pageSize="@Model.PageSize" asp-route-farmName="@Model.FarmName">الأولى</a>
                    </li>
                    <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="FarmMeals" asp-route-page="@(Model.Page - 1)"
                           asp-route-pageSize="@Model.PageSize" asp-route-farmName="@Model.FarmName">السابق</a>
                    </li>
                    @for (var pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="FarmMeals" asp-route-page="@pageNumber"
                               asp-route-pageSize="@Model.PageSize" asp-route-farmName="@Model.FarmName">@pageNumber</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="FarmMeals" asp-route-page="@(Model.Page + 1)"
                           asp-route-pageSize="@Model.PageSize" asp-route-farmName="@Model.FarmName">التالي</a>
                    </li>
                    <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="FarmMeals" asp-route-page="@Model.TotalPages"
                           asp-route-pageSize="@Model.PageSize" asp-route-farmName="@Model.FarmName">الأخيرة</a>
                    </li>
                </ul>
            </nav>
        }
        <p class="text-muted text-center mt-3">
            عرض @((Model.Page - 1) * Model.PageSize + 1) إلى @Math.Min(Model.Page * Model.PageSize, Model.TotalCount)
            من @Model.TotalCount وجبة
        </p>
    }
</div>
