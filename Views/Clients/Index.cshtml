@model ClientFilterViewModel
@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "العملاء";
    var listAction = ViewBag.ClientListAction as string ?? "Index";
}

<div class="fade-in">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">
            <i class="fas fa-users me-2 text-success"></i>@(pageTitle == "تفاصيل العملاء" ? "تفاصيل العملاء" : "قائمة العملاء")
        </h3>
        <div class="d-flex gap-2">
            <a asp-controller="Transactions" asp-action="BulkMeal" class="btn btn-outline-success">
                <i class="fas fa-weight me-1"></i> إدخال وجبات 
            </a>
            <a asp-action="ExportExcel" class="btn btn-outline-success">
                <i class="fas fa-file-excel me-1"></i> تصدير Excel
            </a>
            <a asp-action="Create" class="btn btn-success">
                <i class="fas fa-user-plus me-1"></i> عميل جديد
            </a>
        </div>
    </div>

    @if (Model.CollectionWarnings.Count > 0)
    {
        <div class="alert alert-warning mb-4" role="alert">
            <h5 class="alert-heading fw-bold">
                <i class="fas fa-triangle-exclamation me-1"></i>
                عملاء لم يتم التحصيل منهم منذ 3 أيام أو أكثر
            </h5>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var client in Model.CollectionWarnings)
                {
                    <a asp-action="Profile" asp-route-id="@client.ClientId"
                       class="badge bg-warning text-dark text-decoration-none fs-6">
                        @client.Name
                        @if (client.DaysSinceCollection.HasValue)
                        {
                            <span class="fw-normal">
                                (آخر تحصيل منذ @client.DaysSinceCollection يوم)
                            </span>
                        }
                        else
                        {
                            <span class="fw-normal">(لم يسبق التحصيل)</span>
                        }
                    </a>
                }
            </div>
        </div>
    }

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card card-dashboard border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">عدد العملاء</h6>
                            <div class="display-6 text-primary">@Model.TotalCount</div>
                        </div>
                        <i class="fas fa-users fa-2x text-primary opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-dashboard border-danger">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">إجمالي المستحقات</h6>
                            <div class="display-6 text-danger">@Model.TotalDue.ToString("#,##0.####")</div>
                        </div>
                        <i class="fas fa-coins fa-2x text-danger opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
      @*   <div class="col-md-4">
            <div class="card card-dashboard border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">إجمالي الوجبات</h6>
                            <div class="display-6 text-success">@Model.TotalTransactions</div>
                        </div>
                        <i class="fas fa-receipt fa-2x text-success opacity-50"></i>
                    </div>
                </div>
            </div>
        </div> *@
    </div>

    <!-- Search & Filter -->
    <div class="search-box">
        <form method="get" id="clientFilterForm">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label for="clientSearch" class="form-label"><i class="fas fa-search me-1"></i>بحث باسم العميل</label>
                    <input id="clientSearch" type="search" class="form-control"
                           placeholder="اكتب اسم العميل أو رقم التليفون..." data-client-search autocomplete="off" />
                </div>
                <div class="col-sm-6 col-md-2">
                    <label for="clientPageSize" class="form-label">العملاء بالصفحة</label>
                    <select id="clientPageSize" class="form-select" data-client-page-size>
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                </div>
                <div class="col-sm-6 col-md-4">
                    <label class="form-label">ترتيب حسب</label>
                    <select name="sortBy" class="form-select" onchange="this.form.requestSubmit()">
                        <option value="Name" selected="@(Model.SortBy == "Name")">الاسم</option>
                        <option value="TotalDue" selected="@(Model.SortBy == "TotalDue")">إجمالي ما عليه</option>
                        <option value="LastTransaction" selected="@(Model.SortBy == "LastTransaction")">آخر وجبة</option>
                    </select>
                </div>
            </div>
        </form>
    </div>

    <!-- Clients Table -->
    @if (Model.Clients.Any())
    {
        <div class="card" data-client-table-card>
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0" id="clientsTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>اسم العميل</th>
                            <th>إجمالي ما عليه</th>
                            <th>رقم التليفون</th>
                            <th>عدد التحصيل </th>
                            <th>آخر تحصيل</th>
                            <th class="no-print">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Clients.Count; i++)
                        {
                            var client = Model.Clients[i];
                            <tr data-client-row data-client-search-text="@client.Name @client.Phone">
                                <td data-client-number>@(i + 1)</td>
                                <td class="fw-bold">
                                    @if (client.IsFridge)
                                    {
                                        <i class="fas fa-snowflake text-info me-1"></i>
                                    }
                                    @client.Name
                                </td>
                                <td class="client-total-due">
                                    <span class="text-danger fw-bold">
                                        @client.TotalDue.ToString("#,##0.####")
                                    </span>
                                </td>
                                <td dir="ltr" class="text-center">@(client.Phone ?? "-")</td>
                                <td>
                                    <span class="badge bg-secondary">@client.TransactionCount</span>
                                </td>
                                <td>
                                    @if (client.LastTransactionDate.HasValue)
                                    {
                                        @client.LastTransactionDate.Value.ToString("yyyy/MM/dd")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="no-print">
                                    <div class="d-flex gap-1">
                                        @if (client.IsFridge)
                                        {
                                            <a asp-controller="StripInventory" asp-action="Fridge"
                                               class="btn btn-sm btn-info text-white btn-action" title="فتح التلاجة">
                                                <i class="fas fa-snowflake me-1"></i>فتح التلاجة
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="Profile" asp-route-id="@client.Id"
                                               class="btn btn-sm btn-success btn-action" title="ملف العميل">
                                                <i class="fas fa-folder-open"></i>
                                            </a>

                                            <a asp-action="Edit" asp-route-id="@client.Id"
                                               class="btn btn-sm btn-warning btn-action" title="تعديل">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="ExportClientExcel" asp-route-id="@client.Id"
                                               class="btn btn-sm btn-outline-success btn-action" title="تنزيل Excel">
                                                <i class="fas fa-file-excel"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@client.Id" method="post"
                                                  data-confirm="هل أنت متأكد من حذف العميل '@client.Name'؟"
                                                  style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger btn-action" title="حذف">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3"
             data-client-pagination>
            <span class="text-muted" data-client-page-summary aria-live="polite"></span>
            <nav aria-label="التنقل بين صفحات العملاء">
                <ul class="pagination mb-0" data-client-page-links></ul>
            </nav>
        </div>
    }
    else
    {
        <div class="card">
            <div class="empty-state">
                <i class="fas fa-users-slash"></i>
                @if (string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <h4>لا يوجد عملاء</h4>
                    <p class="text-muted">ابدأ بإضافة عملاء جدد</p>
                    <a asp-action="Create" class="btn btn-success mt-2">
                        <i class="fas fa-user-plus me-1"></i> إضافة عميل
                    </a>
                }
                else
                {
                    <h4>لا توجد نتائج</h4>
                    <p class="text-muted">لم يتم العثور على عملاء يطابقون بحثك</p>
                }
            </div>
        </div>
    }

    <div class="card d-none" data-client-no-results>
        <div class="empty-state">
            <i class="fas fa-users-slash"></i>
            <h4>لا توجد نتائج</h4>
            <p class="text-muted">لم يتم العثور على عملاء يطابقون بحثك</p>
        </div>
    </div>
</div>
