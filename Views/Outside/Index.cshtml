@model OutsideCustomersViewModel
@{
    ViewData["Title"] = "عملاء الخارج";
}

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">
            <i class="fas fa-right-left me-2 text-success"></i>قائمة عملاء الخارج
        </h3>
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-user-plus me-1"></i> إضافة عميل خارج
        </a>
    </div>

    @if (Model.CollectionWarnings.Count > 0)
    {
        <div class="alert alert-warning mb-4" role="alert">
            <h5 class="alert-heading fw-bold">
                <i class="fas fa-triangle-exclamation me-1"></i>
                عملاء الخارج الذين لم يتم التحصيل منهم منذ 3 أيام أو أكثر
            </h5>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var customer in Model.CollectionWarnings)
                {
                    <a asp-action="Profile" asp-route-id="@customer.CustomerId"
                       class="badge bg-warning text-dark text-decoration-none fs-6">
                        @customer.Name
                        @if (customer.DaysSinceCollection.HasValue)
                        {
                            <span class="fw-normal">
                                (آخر تحصيل منذ @customer.DaysSinceCollection يوم)
                            </span>
                        }
                        else
                        {
                            <span class="fw-normal">(لم يسبق التحصيل)</span>
                        }
                    </a>
                }
            </div>
        </div>
    }

    <div class="search-box mb-4">
        <form method="get" asp-action="Index" id="outsideFilterForm">
            <label for="outsideCustomerSearch" class="form-label">
                <i class="fas fa-search me-1"></i>بحث عن عميل الخارج
            </label>
            <input id="outsideCustomerSearch" type="search" value="@Model.SearchTerm"
                   class="form-control" placeholder="ابحث بالاسم أو رقم التليفون..."
                   data-outside-search autocomplete="off" />
            <div class="row g-2 align-items-end mt-2">
                <div class="col-sm-3 col-md-2">
                    <label for="outsidePageSize" class="form-label">العملاء بالصفحة</label>
                    <select id="outsidePageSize" class="form-select" data-outside-page-size>
                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                        <option value="25" selected="@(Model.PageSize == 25)">25</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                    </select>
                </div>
            </div>
        </form>
    </div>

    @if (Model.Customers.Count > 0)
    {
        <div class="card" data-outside-table-card>
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>اسم العميل</th>
                            <th>رقم التليفون</th>
                            <th>الباقي عليه</th>
                            <th>عدد الحركات</th>
                            <th>آخر حركة</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var index = 0; index < Model.Customers.Count; index++)
                        {
                            var customer = Model.Customers[index];
                            <tr data-outside-row data-outside-search-text="@customer.Name @customer.Phone">
                                <td data-outside-number>@(index + 1)</td>
                                <td class="fw-bold">@customer.Name</td>
                                <td dir="ltr" class="text-center">@(customer.Phone ?? "-")</td>
                                <td class="fw-bold text-danger">@customer.Balance.ToString("#,##0.##")</td>
                                <td><span class="badge bg-secondary">@customer.EntryCount</span></td>
                                <td>
                                    @(customer.LastEntryDate?.ToString("yyyy/MM/dd") ?? "-")
                                </td>
                                <td>
                                    <a asp-action="Profile" asp-route-id="@customer.Id"
                                       class="btn btn-sm btn-success" title="ملف العميل">
                                        <i class="fas fa-folder-open me-1"></i> الملف
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@customer.Id"
                                       class="btn btn-sm btn-warning" title="تعديل بيانات العميل">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@customer.Id" method="post"
                                          data-confirm="هل أنت متأكد من حذف العميل '@customer.Name' وكل حركاته؟"
                                          class="d-inline">
                                        <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                        <button type="submit" class="btn btn-sm btn-danger" title="حذف العميل">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3"
             data-outside-pagination>
            <span class="text-muted" data-outside-page-summary aria-live="polite"></span>
            <nav aria-label="التنقل بين صفحات عملاء الخارج">
                <ul class="pagination mb-0" data-outside-page-links></ul>
            </nav>
        </div>
    }
    else
    {
        <div class="card">
            <div class="empty-state">
                <i class="fas fa-users-slash"></i>
                @if (string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <h4>لا يوجد عملاء خارج</h4>
                    <p class="text-muted">ابدأ بإضافة عميل خارج جديد</p>
                    <a asp-action="Create" class="btn btn-success mt-2">
                        <i class="fas fa-user-plus me-1"></i> إضافة عميل خارج
                    </a>
                }
                else
                {
                    <h4>لا توجد نتائج</h4>
                    <p class="text-muted">لم يتم العثور على عميل يطابق البحث</p>
                }
            </div>
        </div>
    }

    <div class="card d-none" data-outside-no-results>
        <div class="empty-state">
            <i class="fas fa-users-slash"></i>
            <h4>لا توجد نتائج</h4>
            <p class="text-muted">لم يتم العثور على عميل يطابق البحث</p>
        </div>
    </div>
</div>
