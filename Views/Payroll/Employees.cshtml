@model PayrollEmployeesViewModel
@{
    ViewData["Title"] = "الموظفون";
}

<div class="fade-in">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="fas fa-users me-2 text-success"></i>الموظفون
            </h3>
            <div class="text-muted">بيانات الموظفين والرواتب الشهرية.</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-outline-dark">
                <i class="fas fa-money-check-dollar me-1"></i> المرتبات
            </a>
            <a asp-action="Advances" class="btn btn-outline-dark">
                <i class="fas fa-hand-holding-dollar me-1"></i> السلف
            </a>
            <a asp-action="Custodies" class="btn btn-outline-dark">
                <i class="fas fa-wallet me-1"></i> العهد
            </a>
            <a asp-action="CreateEmployee" class="btn btn-success">
                <i class="fas fa-user-plus me-1"></i> موظف جديد
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-4">
            <div class="card card-dashboard border-primary h-100">
                <div class="card-body">
                    <div class="text-muted">عدد الموظفين العاملين</div>
                    <div class="fs-3 fw-bold">@Model.ActiveCount</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="card card-dashboard border-success h-100">
                <div class="card-body">
                    <div class="text-muted">إجمالي الرواتب الشهرية</div>
                    <div class="fs-3 fw-bold text-success">@Model.TotalMonthlySalaries.ToString("#,##0.####")</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="card card-dashboard border-warning h-100">
                <div class="card-body">
                    <div class="text-muted">سلف غير مخصومة</div>
                    <div class="fs-3 fw-bold text-warning">@Model.TotalUnpaidAdvances.ToString("#,##0.####")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>الاسم</th>
                    <th>الوظيفة</th>
                    <th>الهاتف</th>
                    <th>الراتب الشهري</th>
                    <th>تاريخ التعيين</th>
                    <th>سلف غير مخصومة</th>
                    <th>شهور مسجلة</th>
                    <th>الحالة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Employees.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-4">لا يوجد موظفون مسجلون بعد.</td>
                    </tr>
                }
                else
                {
                    @for (var index = 0; index < Model.Employees.Count; index++)
                    {
                        var row = Model.Employees[index];
                        var employee = row.Employee;
                        <tr>
                            <td>@(index + 1)</td>
                            <td class="fw-bold text-nowrap">@employee.Name</td>
                            <td>@(string.IsNullOrWhiteSpace(employee.JobTitle) ? "—" : employee.JobTitle)</td>
                            <td dir="ltr" class="text-start">@(string.IsNullOrWhiteSpace(employee.Phone) ? "—" : employee.Phone)</td>
                            <td class="fw-bold">@employee.MonthlySalary.ToString("#,##0.####")</td>
                            <td class="text-nowrap">@employee.HireDate.ToString("dd/MM/yyyy")</td>
                            <td class="@(row.UnpaidAdvances > 0 ? "text-warning fw-bold" : "text-muted")">
                                @row.UnpaidAdvances.ToString("#,##0.####")
                            </td>
                            <td>@row.PayrollMonthsCount</td>
                            <td>
                                @if (employee.IsActive)
                                {
                                    <span class="badge bg-success">على رأس العمل</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">موقوف</span>
                                }
                            </td>
                            <td class="text-nowrap">
                                <a asp-action="EditEmployee" asp-route-id="@employee.Id"
                                   class="btn btn-sm btn-outline-warning" title="تعديل بيانات الموظف">
                                    <i class="fas fa-edit me-1"></i> تعديل
                                </a>
                                <a asp-action="Advances" asp-route-employeeId="@employee.Id"
                                   class="btn btn-sm btn-outline-success" title="سلف الموظف">
                                    <i class="fas fa-hand-holding-dollar me-1"></i> السلف
                                </a>
                                <form asp-action="ToggleEmployee" asp-route-id="@employee.Id" method="post" class="d-inline"
                                      data-confirm="@(employee.IsActive ? $"هل تريد إيقاف {employee.Name} عن العمل؟ بياناته ستبقى محفوظة." : $"هل تريد تفعيل {employee.Name} مرة أخرى؟")">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        <i class="fas @(employee.IsActive ? "fa-user-slash" : "fa-user-check") me-1"></i>
                                        @(employee.IsActive ? "إيقاف" : "تفعيل")
                                    </button>
                                </form>
                                <form asp-action="DeleteEmployee" asp-route-id="@employee.Id" method="post" class="d-inline"
                                      data-confirm="هل تريد حذف الموظف @employee.Name؟ لا يمكن الحذف إذا كانت له سلف أو مرتبات مسجلة.">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف الموظف">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
