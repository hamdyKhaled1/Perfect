@model OutsidePageViewModel
@{
    ViewData["Title"] = $"حساب {Model.SelectedCustomerName}";
}

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="fas fa-user me-2 text-success"></i>@Model.SelectedCustomerName
            </h3>
            <div class="text-muted">ملف عميل الخارج</div>
        </div>
        <a asp-action="Index" class="btn btn-outline-dark">
            <i class="fas fa-arrow-right me-1"></i> رجوع لقائمة الخارج
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card card-dashboard border-primary">
                <div class="card-body">
                    <div class="text-danger">الباقي عليه</div>
                    <div class="display-6 @(Model.RemainingBalance > 0 ? "text-danger" : Model.RemainingBalance < 0 ? "text-primary" : "")">
                        @Model.RemainingBalance.ToString("#,##0.##")
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-dashboard border-success">
                <div class="card-body">
                    <div class="text-muted">إجمالي عليه</div>
                    <div class="display-6 text-success">@Model.Entries.Sum(entry => entry.Taken).ToString("#,##0.##")</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-dashboard border-info">
                <div class="card-body">
                    <div class="text-muted">إجمالي له</div>
                    <div class="display-6 text-info">@Model.Entries.Sum(entry => entry.Incoming).ToString("#,##0.##")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="fw-bold mb-3">تسجيل حركة</h5>
            <form asp-action="AddEntry" method="post">
                <input name="CustomerId" type="hidden" value="@Model.SelectedCustomerId" />
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label for="Statement" class="form-label">البيان / الملاحظات</label>
                        <input id="Statement" name="Statement" value="@Model.NewEntry.Statement"
                               class="form-control" maxlength="500" />
                        <span class="text-danger small">@Html.ValidationMessage("Statement")</span>
                    </div>
                    <div class="col-md-2">
                        <label for="Taken" class="form-label">عليه</label>
                        <input id="Taken" name="Taken" type="number" min="0" step="0.01"
                               value="@Model.NewEntry.Taken" class="form-control" />
                        <span class="text-danger small">@Html.ValidationMessage("Taken")</span>
                    </div>
                    <div class="col-md-2">
                        <label for="Incoming" class="form-label">له</label>
                        <input id="Incoming" name="Incoming" type="number" min="0" step="0.01"
                               value="@Model.NewEntry.Incoming" class="form-control" />
                        <span class="text-danger small">@Html.ValidationMessage("Incoming")</span>
                    </div>
                    <div class="col-md-2">
                        <label for="Date" class="form-label">التاريخ</label>
                        <input id="Date" name="Date" type="date" value="@Model.NewEntry.Date.ToString("yyyy-MM-dd")"
                               class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="fas fa-plus me-1"></i> تسجيل الحركة
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>التاريخ</th>
                    <th>البيان / الملاحظات</th>
                    <th>له</th>
                    <th>عليه</th>
                    <th>الباقي عليه</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Entries.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">لا توجد حركات مسجلة لهذا العميل.</td>
                    </tr>
                }
                else
                {
                    @for (var index = 0; index < Model.Entries.Count; index++)
                    {
                        var entry = Model.Entries[index];
                        <tr>
                            <td>@(index + 1)</td>
                            <td>@entry.Date.ToString("dd/MM/yyyy")</td>
                            <td>@entry.Statement</td>
                            <td>@entry.Incoming.ToString("#,##0.##")</td>
                            <td>@entry.Taken.ToString("#,##0.##")</td>
                            <td class="fw-bold @(entry.Balance > 0 ? "text-danger" : entry.Balance < 0 ? "text-primary" : "")">
                                @entry.Balance.ToString("#,##0.##")
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="EditEntry" asp-route-id="@entry.Id"
                                       class="btn btn-sm btn-outline-warning" title="تعديل الحركة">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                    <form asp-action="DeleteEntry" asp-route-id="@entry.Id" method="post"
                                          data-confirm="هل أنت متأكد من حذف هذه الحركة؟">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف الحركة">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
            @if (Model.Entries.Count > 0)
            {
                <tfoot>
                    <tr class="table-dark fw-bold">
                        <td colspan="3">الإجمالي</td>
                        <td>@Model.Entries.Sum(entry => entry.Incoming).ToString("#,##0.##")</td>
                        <td>@Model.Entries.Sum(entry => entry.Taken).ToString("#,##0.##")</td>
                        <td class="@(Model.RemainingBalance > 0 ? "text-danger" : Model.RemainingBalance < 0 ? "text-primary" : "")">
                            @Model.RemainingBalance.ToString("#,##0.##")
                        </td>
                        <td></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>
