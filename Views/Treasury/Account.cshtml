@model HagImamAccounts.ViewModels.TreasuryMovementViewModel
@{
    ViewData["Title"] = Model.AccountName;
    var isGeneral = Model.Account == HagImamAccounts.Models.TreasuryAccount.General;
    var isWallet = Model.Account is HagImamAccounts.Models.TreasuryAccount.AbuMazenVodafoneCash
        or HagImamAccounts.Models.TreasuryAccount.AbuMazenInstaPay
        or HagImamAccounts.Models.TreasuryAccount.HajjImamVodafoneCash
        or HagImamAccounts.Models.TreasuryAccount.HajjImamInstaPay
        or HagImamAccounts.Models.TreasuryAccount.MohamedAbdelrahmanVodafoneCash
        or HagImamAccounts.Models.TreasuryAccount.MohamedAbdelrahmanInstaPay;
}

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="fas fa-vault me-2 text-success"></i>@Model.AccountName
            </h3>
            <div class="text-muted">رصيد الخزنة</div>
            <div class="display-6 @(Model.Balance < 0 ? "text-danger" : "text-success")">
                @Model.Balance.ToString("#,##0.####")
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-dark">
            <i class="fas fa-arrow-right me-1"></i> رجوع للخزن
        </a>
    </div>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="fw-bold mb-3">تسجيل حركة</h5>
            <form asp-action="AddEntry" asp-route-account="@Model.Account" method="post">
                <div class="row g-3 align-items-end">
                    <div class="col-lg-4">
                        <label asp-for="NewEntry.Statement" class="form-label">البيان</label>
                        <input asp-for="NewEntry.Statement" class="form-control" maxlength="500" />
                        <span asp-validation-for="NewEntry.Statement" class="text-danger small"></span>
                    </div>
                    @if (isGeneral)
                    {
                        <input asp-for="NewEntry.Incoming" type="hidden" value="0" />
                        <div class="col-sm-6 col-lg-2">
                            <label asp-for="NewEntry.Outgoing" class="form-label">صادر</label>
                            <input asp-for="NewEntry.Outgoing" type="number" min="0" step="0.0001" class="form-control" />
                            <span asp-validation-for="NewEntry.Outgoing" class="text-danger small"></span>
                        </div>
                    }
                    else
                    {
                        <div class="col-sm-6 col-lg-2">
                            <label asp-for="NewEntry.Incoming" class="form-label">وارد</label>
                            <input asp-for="NewEntry.Incoming" type="number" min="0" step="0.0001" class="form-control" />
                            <span asp-validation-for="NewEntry.Incoming" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6 col-lg-2">
                            <label asp-for="NewEntry.Outgoing" class="form-label">صادر</label>
                            <input asp-for="NewEntry.Outgoing" type="number" min="0" step="0.0001" class="form-control" />
                            <span asp-validation-for="NewEntry.Outgoing" class="text-danger small"></span>
                        </div>
                    }
                    <div class="col-sm-6 col-lg-2">
                        <label asp-for="NewEntry.Date" class="form-label">التاريخ</label>
                        <input asp-for="NewEntry.Date" type="date" class="form-control" />
                    </div>
                    <div class="col-lg-2">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="fas fa-plus me-1"></i> تسجيل الحركة
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (isWallet)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="fw-bold mb-3">تسييل / تجميد</h5>
                <form asp-action="WalletMovement" asp-route-account="@Model.Account" method="post">
                    <div class="row g-3 align-items-end">
                        <div class="col-lg-4">
                            <label asp-for="NewWalletMovement.Statement" class="form-label">البيان</label>
                            <input asp-for="NewWalletMovement.Statement" class="form-control" maxlength="400" />
                            <span asp-validation-for="NewWalletMovement.Statement" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6 col-lg-2">
                            <label asp-for="NewWalletMovement.Amount" class="form-label">المبلغ</label>
                            <input asp-for="NewWalletMovement.Amount" type="number" min="0.0001" step="0.0001" class="form-control" />
                            <span asp-validation-for="NewWalletMovement.Amount" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6 col-lg-2">
                            <label asp-for="NewWalletMovement.IsFreeze" class="form-label">نوع الحركة</label>
                            <select asp-for="NewWalletMovement.IsFreeze" class="form-select">
                                <option value="false">تسييل</option>
                                <option value="true">تجميد</option>
                            </select>
                        </div>
                        <div class="col-sm-6 col-lg-2">
                            <label asp-for="NewWalletMovement.Date" class="form-label">التاريخ</label>
                            <input asp-for="NewWalletMovement.Date" type="date" class="form-control" />
                        </div>
                        <div class="col-lg-2">
                            <button type="submit" class="btn btn-outline-success w-100">
                                <i class="fas fa-right-left me-1"></i> تسجيل الحركة
                            </button>
                        </div>
                    </div>
                </form>
                <div class="text-muted small mt-2">التسييل صادر من المحفظة ووارد للنقدي، والتجميد صادر من النقدي ووارد للمحفظة.</div>
            </div>
        </div>
    }

    @if (!isGeneral)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="fw-bold mb-3">تحويل إلى الخزنة العمومية</h5>
                <form asp-action="TransferToGeneral" asp-route-account="@Model.Account" method="post">
                    <div class="row g-3 align-items-end">
                        <div class="col-lg-5">
                            <label asp-for="NewTransfer.Statement" class="form-label">البيان</label>
                            <input asp-for="NewTransfer.Statement" class="form-control" maxlength="400" />
                            <span asp-validation-for="NewTransfer.Statement" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6 col-lg-2">
                            <label asp-for="NewTransfer.Amount" class="form-label">مبلغ التحويل</label>
                            <input asp-for="NewTransfer.Amount" type="number" min="0.0001" step="0.0001" class="form-control" />
                            <span asp-validation-for="NewTransfer.Amount" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6 col-lg-2">
                            <label asp-for="NewTransfer.Date" class="form-label">التاريخ</label>
                            <input asp-for="NewTransfer.Date" type="date" class="form-control" />
                        </div>
                        <div class="col-lg-3">
                            <button type="submit" class="btn btn-outline-success w-100">
                                <i class="fas fa-right-left me-1"></i> تحويل وتسجيل الطرفين
                            </button>
                        </div>
                    </div>
                </form>
                <div class="text-muted small mt-2">التحويل يخصم من هذه الخزنة ويضيف نفس المبلغ للعمومية تلقائيًا.</div>
            </div>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>التاريخ</th>
                    <th>البيان</th>
                    <th>وارد</th>
                    <th>صادر</th>
                    <th>الرصيد</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Entries.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">لا توجد حركات مسجلة لهذه الخزنة.</td>
                    </tr>
                }
                else
                {
                    @for (var index = 0; index < Model.Entries.Count; index++)
                    {
                        var entry = Model.Entries[index];
                        <tr>
                            <td>@(index + 1)</td>
                            <td class="text-nowrap">@entry.Date.ToString("dd/MM/yyyy")</td>
                            <td>
                                @entry.Statement
                                @if (entry.IsTransfer)
                                {
                                    <span class="badge bg-info text-dark">تحويل</span>
                                }
                                @if (entry.TransactionId.HasValue)
                                {
                                    <a href="/Transactions/Details/@entry.TransactionId" class="badge bg-success-subtle text-success border border-success-subtle ms-1 text-decoration-none" title="عرض تفاصيل التحصيل">
                                        <i class="fas fa-receipt me-1"></i>تحصيل
                                    </a>
                                }
                                @if (entry.IsFridgeLinked)
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle ms-1" title="حركة تلقائية من التلاجة">
                                        <i class="fas fa-snowflake me-1"></i>التلاجة
                                    </span>
                                }
                                @if (entry.IsExpenseLinked)
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle ms-1" title="حركة تلقائية من المصروفات">
                                        <i class="fas fa-money-bill-transfer me-1"></i>مصروف
                                    </span>
                                }
                            </td>
                            <td>@entry.Incoming.ToString("#,##0.####")</td>
                            <td>@entry.Outgoing.ToString("#,##0.####")</td>
                            <td class="fw-bold @(entry.Balance < 0 ? "text-danger" : "")">@entry.Balance.ToString("#,##0.####")</td>
                            <td>
                                <div class="d-flex gap-1">
                                    @if (entry.IsFridgeLinked)
                                    {
                                        <span class="text-muted small"><i class="fas fa-lock me-1"></i>من التلاجة</span>
                                    }
                                    else if (entry.IsExpenseLinked)
                                    {
                                        <span class="text-muted small"><i class="fas fa-lock me-1"></i>من المصروفات</span>
                                    }
                                    else if (!entry.TransactionId.HasValue)
                                    {
                                        <a asp-action="EditEntry" asp-route-account="@Model.Account" asp-route-id="@entry.Id"
                                           class="btn btn-sm btn-outline-warning" title="تعديل الحركة">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <form asp-action="DeleteEntry" asp-route-account="@Model.Account" asp-route-id="@entry.Id"
                                              method="post" data-confirm="هل أنت متأكد من حذف هذه الحركة؟ سيتم حذف طرفي التحويل معًا إن كانت تحويلًا.">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف الحركة">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><i class="fas fa-lock me-1"></i>مربوطة بتحصيل</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>
