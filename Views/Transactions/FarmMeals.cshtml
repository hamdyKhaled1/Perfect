@model IReadOnlyList<HagImamAccounts.Models.FarmMealBatch>
@{
    ViewData["Title"] = "أرشيف الوجبات";
}

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">
            <i class="fas fa-box-archive me-2 text-success"></i>أرشيف الوجبات الموزعة
        </h4>
        <a asp-action="BulkMeal" class="btn btn-success">
            <i class="fas fa-plus me-1"></i> إدخال وجبات
        </a>
    </div>

    <form asp-action="FarmMeals" method="get" class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label for="farmName" class="form-label">فلترة باسم المزرعة</label>
                    <input id="farmName" name="farmName" type="search" class="form-control"
                           value="@ViewBag.FarmName" placeholder="اكتب اسم المزرعة..." />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-success">
                        <i class="fas fa-search me-1"></i> بحث
                    </button>
                    <a asp-action="FarmMeals" class="btn btn-outline-secondary">عرض الكل</a>
                </div>
            </div>
        </div>
    </form>

    @if (Model.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center text-muted py-5">
                <i class="fas fa-inbox fa-2x mb-3"></i>
                <p class="mb-0">
                    @(string.IsNullOrEmpty(ViewBag.FarmName as string)
                        ? "لا توجد وجبات محفوظة حتى الآن."
                        : "لا توجد وجبات محفوظة باسم المزرعة المطلوب.")
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>التاريخ</th>
                        <th>اسم المزرعة</th>
                        <th>سعر الكيلو</th>
                        <th>عدد العملاء</th>
                        <th>وزن المزرعة</th>
                        <th>حساب المزرعة</th>
                        <th>الأرباح</th>
                        <th>التفاصيل</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var batch in Model)
                    {
                        <tr>
                            <td class="text-nowrap">@batch.Date.ToString("dd/MM/yyyy")</td>
                            <td>@(string.IsNullOrWhiteSpace(batch.FarmName) ? "—" : batch.FarmName)</td>
                            <td>@batch.FarmPrice.ToString("#,##0.####")</td>
                            <td>@batch.Transactions.Count</td>
                            <td>@batch.FarmWeight.ToString("#,##0.####")</td>
                            <td>@batch.FarmAccount.ToString("#,##0.####")</td>
                            <td class="fw-bold">@batch.Profit.ToString("#,##0.####")</td>
                            <td>
                                <a asp-action="FarmMealDetails" asp-route-id="@batch.Id" class="btn btn-sm btn-outline-success">
                                    <i class="fas fa-eye me-1"></i> عرض التوزيع
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
