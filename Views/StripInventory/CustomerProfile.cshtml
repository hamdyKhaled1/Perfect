@model HagImamAccounts.ViewModels.StripCustomerProfileViewModel
@{
    ViewData["Title"] = $"حساب {Model.CustomerName} - الاستربس";
    string CartonTypeName(HagImamAccounts.Models.StripCartonType cartonType) =>
        cartonType == HagImamAccounts.Models.StripCartonType.FiveKilogram ? "5 كيلو" : "900 جرام";
    string EntryTypeName(HagImamAccounts.Models.StripEntryType entryType) => entryType switch
    {
        HagImamAccounts.Models.StripEntryType.Sale => "بيع",
        HagImamAccounts.Models.StripEntryType.Payment => "دفعة",
        HagImamAccounts.Models.StripEntryType.Return => "مرتجع",
        HagImamAccounts.Models.StripEntryType.StockIn => "وارد مخزن",
        HagImamAccounts.Models.StripEntryType.StockOut => "منصرف مخزن",
        _ => ""
    };
}

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="fas fa-user me-2 text-success"></i>@Model.CustomerName
            </h3>
            <div class="text-muted">ملف عميل الاستربس @(Model.Phone ?? string.Empty) | البيان: @Model.CustomerName</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="EditCustomer" asp-route-id="@Model.CustomerId" class="btn btn-warning">
                <i class="fas fa-edit me-1"></i> تعديل العميل
            </a>
            <a asp-action="Customers" class="btn btn-outline-dark">
                <i class="fas fa-arrow-right me-1"></i> رجوع لقائمة العملاء
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card card-dashboard border-primary">
                <div class="card-body text-center">
                    <div class="text-muted">إجمالي المبيعات</div>
                    <div class="h4 fw-bold mb-0">@Model.TotalSales.ToString("#,##0.##") جنيه</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-dashboard border-success">
                <div class="card-body text-center">
                    <div class="text-muted">إجمالي المدفوعات</div>
                    <div class="h4 fw-bold mb-0 text-success">@Model.TotalPaid.ToString("#,##0.##") جنيه</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-dashboard border-danger">
                <div class="card-body text-center">
                    <div class="text-muted">الباقي عليه</div>
                    <div class="h4 fw-bold mb-0 text-danger">@Model.TotalDue.ToString("#,##0.##") جنيه</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-dashboard border-info">
                <div class="card-body text-center">
                    <div class="text-muted">رصيد المخزن للعميل</div>
                    <div class="fw-bold">5 كيلو: @Model.FiveKilogramBalance.ToString("#,##0") | 900 جرام: @Model.NineHundredGramBalance.ToString("#,##0")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-3"><i class="fas fa-cart-plus me-2 text-success"></i>بيع كراتين</h5>
                    <form asp-action="AddCustomerEntry" method="post">
                        <input asp-for="NewEntry.CustomerId" type="hidden" />
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>
                        <div class="row g-3 align-items-end">
                            <div class="col-md-3">
                                <label asp-for="NewEntry.CartonType" class="form-label">نوع الكراتين</label>
                                <select asp-for="NewEntry.CartonType" class="form-select">
                                    <option value="@HagImamAccounts.Models.StripCartonType.FiveKilogram">5 كيلو</option>
                                    <option value="@HagImamAccounts.Models.StripCartonType.NineHundredGram">900 جرام</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label asp-for="NewEntry.Date" class="form-label">التاريخ</label>
                                <input asp-for="NewEntry.Date" type="date" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="NewEntry.Statement" class="form-label">البيان</label>
                                <input asp-for="NewEntry.Statement" class="form-control" maxlength="500" placeholder="اسم العميل / البيان" value="@Model.CustomerName" />
                            </div>
                            <div class="col-md-2">
                                <label asp-for="NewEntry.Cartons" class="form-label">خد كام كرتونة</label>
                                <input asp-for="NewEntry.Cartons" type="number" min="1" step="1" class="form-control" id="saleCartons" />
                                <span asp-validation-for="NewEntry.Cartons" class="text-danger small"></span>
                            </div>
                            <div class="col-md-2">
                                <label asp-for="NewEntry.PricePerCarton" class="form-label">سعر الكرتونة</label>
                                <input asp-for="NewEntry.PricePerCarton" type="number" min="0" step="0.01" class="form-control" id="salePrice" />
                                <span asp-validation-for="NewEntry.PricePerCarton" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">عليه = خد كام × سعر الكرتونه</label>
                                <input type="text" class="form-control bg-light" id="saleTotal" readonly value="0" />
                            </div>
                            <div class="col-md-6">
                                <button type="submit" class="btn btn-success w-100 mt-4">
                                    <i class="fas fa-save me-1"></i> تسجيل البيع ويضاف عليه
                                </button>
                            </div>
                        </div>
                    </form>
                    <div class="text-muted small mt-2">
                        عند البيع يقل المخزن مباشرةً حسب نوع الكراتين المختار.
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-3"><i class="fas fa-hand-holding-usd me-2 text-primary"></i>تسجيل دفعة</h5>
                    <form asp-action="AddCustomerPayment" method="post">
                        <input asp-for="NewPayment.CustomerId" type="hidden" />
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>
                        <div class="row g-3 align-items-end">
                            <div class="col-md-4">
                                <label asp-for="NewPayment.Date" class="form-label">التاريخ</label>
                                <input asp-for="NewPayment.Date" type="date" class="form-control" />
                            </div>
                            <div class="col-md-8">
                                <label asp-for="NewPayment.Statement" class="form-label">البيان</label>
                                <input asp-for="NewPayment.Statement" class="form-control" maxlength="500" placeholder="دفع كام" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NewPayment.PaidAmount" class="form-label">دفع كام</label>
                                <input asp-for="NewPayment.PaidAmount" type="number" min="0.01" step="0.01" class="form-control" />
                                <span asp-validation-for="NewPayment.PaidAmount" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NewPayment.TreasuryAccount" class="form-label">خزنة التحصيل</label>
                                <select asp-for="NewPayment.TreasuryAccount" class="form-select">
                                    <option value="@HagImamAccounts.Models.TreasuryAccount.AbuMazenCash">خزنة أبو مازن - نقدي</option>
                                    <option value="@HagImamAccounts.Models.TreasuryAccount.AbuMazenVodafoneCash">فودافون كاش - أبو مازن</option>
                                    <option value="@HagImamAccounts.Models.TreasuryAccount.AbuMazenInstaPay">إنستا باي - أبو مازن</option>
                                    <option value="@HagImamAccounts.Models.TreasuryAccount.MohamedAbdelrahmanCash">خزنة محمد عبدالرحمن - نقدي</option>
                                    <option value="@HagImamAccounts.Models.TreasuryAccount.MohamedAbdelrahmanVodafoneCash">فودافون كاش - محمد عبدالرحمن</option>
                                    <option value="@HagImamAccounts.Models.TreasuryAccount.MohamedAbdelrahmanInstaPay">إنستا باي - محمد عبدالرحمن</option>
                                </select>
                                <span asp-validation-for="NewPayment.TreasuryAccount" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <button type="submit" class="btn btn-primary w-100 mt-4">
                                    <i class="fas fa-check me-1"></i> تسجيل الدفعة
                                </button>
                            </div>
                        </div>
                    </form>
                    <div class="text-muted small mt-2">
                        الدفعة تخصم من "عليه" وتظهر كـ "له".
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="fw-bold mb-3"><i class="fas fa-list me-2 text-success"></i>حركات العميل</h5>
            <div class="table-responsive">
                <table class="table table-striped table-hover table-bordered align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>التاريخ</th>
                            <th>نوع الحركة</th>
                            <th>نوع الكراتين</th>
                            <th>البيان</th>
                            <th>خد كام كرتونة</th>
                            <th>سعر الكرتونة</th>
                            <th>عليه (الإجمالي)</th>
                            <th>دفع كام (له)</th>
                            <th>الباقي عليه</th>
                            <th>رصيد العميل (كراتين)</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Entries.Count == 0)
                        {
                            <tr>
                                <td colspan="12" class="text-center text-muted py-4">لا توجد حركات مسجلة لهذا العميل.</td>
                            </tr>
                        }
                        else
                        {
                            @for (var index = 0; index < Model.Entries.Count; index++)
                            {
                                var entry = Model.Entries[index];
                                <tr>
                                    <td>@(index + 1)</td>
                                    <td>@entry.Date.ToString("dd/MM/yyyy")</td>
                                    <td>@EntryTypeName(entry.EntryType)</td>
                                    <td>@(entry.EntryType == HagImamAccounts.Models.StripEntryType.Payment ? "-" : CartonTypeName(entry.CartonType))</td>
                                    <td>@entry.Statement</td>
                                    <td class="text-center">@(entry.EntryType == HagImamAccounts.Models.StripEntryType.Payment ? "-" : entry.Cartons.ToString("#,##0"))</td>
                                    <td class="text-center">@(entry.EntryType == HagImamAccounts.Models.StripEntryType.Payment ? "-" : entry.PricePerCarton.ToString("#,##0.##"))</td>
                                    <td class="fw-bold text-danger">@(entry.Amount == 0 ? "-" : entry.Amount.ToString("#,##0.##"))</td>
                                    <td class="fw-bold text-success">@(entry.PaidAmount == 0 ? "-" : entry.PaidAmount.ToString("#,##0.##"))</td>
                                    <td class="fw-bold text-primary">@entry.RunningDue.ToString("#,##0.##")</td>
                                    <td class="text-center">@entry.Balance.ToString("#,##0")</td>
                                    <td>
                                        @if (entry.EntryType == HagImamAccounts.Models.StripEntryType.Sale)
                                        {
                                            <div class="d-flex gap-1">
                                                <a asp-action="EditCustomerEntry" asp-route-id="@entry.Id" class="btn btn-sm btn-outline-warning" title="تعديل الحركة">
                                                    <i class="fas fa-pen"></i>
                                                </a>
                                                <form asp-action="DeleteCustomerEntry" asp-route-id="@entry.Id" method="post" data-confirm="هل أنت متأكد من حذف هذه الحركة؟">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف الحركة">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        else if (entry.EntryType == HagImamAccounts.Models.StripEntryType.Payment)
                                        {
                                            <div class="d-flex gap-1">
                                                <a asp-action="EditCustomerEntry" asp-route-id="@entry.Id" class="btn btn-sm btn-outline-warning" title="تعديل الدفعة">
                                                    <i class="fas fa-pen"></i>
                                                </a>
                                                <form asp-action="DeleteCustomerEntry" asp-route-id="@entry.Id" method="post" data-confirm="هل أنت متأكد من حذف هذه الدفعة؟">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف الدفعة">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    @if (Model.Entries.Count > 0)
                    {
                        <tfoot class="table-light">
                            <tr class="fw-bold">
                                <td colspan="5" class="text-end">الإجمالي</td>
                                <td class="text-center">@Model.Entries.Sum(entry => entry.Cartons).ToString("#,##0")</td>
                                <td class="text-center">-</td>
                                <td class="text-danger">@Model.TotalSales.ToString("#,##0.##")</td>
                                <td class="text-success">@Model.TotalPaid.ToString("#,##0.##")</td>
                                <td class="text-primary">@Model.TotalDue.ToString("#,##0.##")</td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const cartonsInput = document.getElementById('saleCartons');
        const priceInput = document.getElementById('salePrice');
        const totalInput = document.getElementById('saleTotal');
        function calcSaleTotal() {
            const cartons = parseFloat(cartonsInput?.value || '0') || 0;
            const price = parseFloat(priceInput?.value || '0') || 0;
            totalInput.value = (cartons * price).toLocaleString('ar-EG');
        }
        cartonsInput?.addEventListener('input', calcSaleTotal);
        priceInput?.addEventListener('input', calcSaleTotal);
    </script>
}
