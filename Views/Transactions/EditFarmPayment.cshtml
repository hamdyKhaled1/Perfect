@model HagImamAccounts.ViewModels.FarmPaymentEditViewModel
@{
    ViewData["Title"] = "تعديل دفعة المزرعة";
}

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0"><i class="fas fa-edit me-2 text-primary"></i>تعديل دفعة المزرعة</h4>
        <a asp-action="FarmAccountDetails" asp-route-farmName="@Model.FarmName" class="btn btn-outline-dark">
            <i class="fas fa-arrow-right me-1"></i> رجوع لكشف الحساب
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="EditFarmPayment" method="post">
                <input asp-for="Id" type="hidden" />
                <input asp-for="FarmName" type="hidden" />
                <input asp-for="HasTreasuryEntry" type="hidden" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">المزرعة</label>
                        <input value="@Model.FarmName" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Statement" class="form-label">البيان</label>
                        <input asp-for="Statement" class="form-control" maxlength="500" />
                        <span asp-validation-for="Statement" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Amount" class="form-label">المبلغ المدفوع</label>
                        <input asp-for="Amount" type="number" min="0.01" step="0.01" class="form-control" />
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Date" class="form-label">تاريخ الدفع</label>
                        <input asp-for="Date" type="date" class="form-control" />
                        <span asp-validation-for="Date" class="text-danger small"></span>
                    </div>
                    @if (Model.HasTreasuryEntry)
                    {
                        <div class="col-md-4">
                            <label asp-for="TreasuryAccount" class="form-label">الدفع من خزنة</label>
                            <select asp-for="TreasuryAccount" class="form-select">
                                @foreach (var account in HagImamAccounts.ViewModels.FarmPaymentInputViewModel.AvailableTreasuryAccounts)
                                {
                                    <option value="@account">@HagImamAccounts.Models.TreasuryEntry.GetAccountName(account)</option>
                                }
                            </select>
                            <span asp-validation-for="TreasuryAccount" class="text-danger small"></span>
                        </div>
                    }
                </div>
                <div class="text-muted small mt-3">
                    @if (Model.HasTreasuryEntry)
                    {
                        <span>سيتم تحديث حركة الخصم المرتبطة بالخزنة بعد الحفظ.</span>
                    }
                    else
                    {
                        <span>هذه دفعة قديمة غير مرتبطة بحركة خزنة؛ تعديلها لن يضيف خصمًا جديدًا لأي خزنة.</span>
                    }
                </div>
                <button type="submit" class="btn btn-success mt-3"><i class="fas fa-check me-1"></i> حفظ التعديلات</button>
            </form>
        </div>
    </div>
</div>
