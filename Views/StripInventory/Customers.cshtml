@model HagImamAccounts.ViewModels.StripCustomersViewModel
@{
    ViewData["Title"] = "عملاء الاستربس";
}

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">
            <i class="fas fa-users me-2 text-success"></i>عملاء الاستربس
        </h3>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-dark">
                <i class="fas fa-arrow-right me-1"></i> رجوع للمخزون
            </a>
            <a asp-action="CreateCustomer" class="btn btn-success">
                <i class="fas fa-user-plus me-1"></i> إضافة عميل
            </a>
        </div>
    </div>

    <div class="search-box mb-4">
        <form method="get" asp-action="Customers">
            <label for="stripCustomerSearch" class="form-label">
                <i class="fas fa-search me-1"></i>بحث عن عميل
            </label>
            <input id="stripCustomerSearch" name="searchTerm" value="@Model.SearchTerm"
                   class="form-control" placeholder="ابحث بالاسم أو رقم التليفون..." />
            <div class="row g-2 align-items-end mt-2">
                <div class="col-sm-3 col-md-2">
                    <label for="stripCustomerPageSize" class="form-label">العملاء بالصفحة</label>
                    <select id="stripCustomerPageSize" name="pageSize" class="form-select" onchange="this.form.requestSubmit()">
                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                        <option value="25" selected="@(Model.PageSize == 25)">25</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                    </select>
                </div>
            </div>
        </form>
    </div>

    @if (Model.Customers.Count > 0)
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>اسم العميل</th>
                            <th>رقم التليفون</th>
                            <th>رصيد 5 كيلو</th>
                            <th>رصيد 900 جرام</th>
                            <th>عدد الحركات</th>
                            <th>آخر حركة</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var index = 0; index < Model.Customers.Count; index++)
                        {
                            var customer = Model.Customers[index];
                            <tr>
                                <td>@((Model.Page - 1) * Model.PageSize + index + 1)</td>
                                <td class="fw-bold">@customer.Name</td>
                                <td dir="ltr" class="text-center">@(customer.Phone ?? "-")</td>
                                <td class="fw-bold">@customer.FiveKilogramBalance.ToString("#,##0") كرتونة</td>
                                <td class="fw-bold">@customer.NineHundredGramBalance.ToString("#,##0") كرتونة</td>
                                <td><span class="badge bg-secondary">@customer.EntryCount</span></td>
                                <td>@(customer.LastEntryDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="CustomerProfile" asp-route-id="@customer.Id"
                                           class="btn btn-sm btn-success" title="ملف العميل">
                                            <i class="fas fa-folder-open me-1"></i> الملف
                                        </a>
                                        <a asp-action="EditCustomer" asp-route-id="@customer.Id"
                                           class="btn btn-sm btn-warning" title="تعديل بيانات العميل">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form asp-action="DeleteCustomer" asp-route-id="@customer.Id" method="post"
                                              data-confirm="هل أنت متأكد من حذف العميل '@customer.Name'؟"
                                              class="d-inline">
                                            <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                                            <input type="hidden" name="page" value="@Model.Page" />
                                            <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                            <button type="submit" class="btn btn-sm btn-danger" title="حذف العميل">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.TotalPages > 1)
        {
            var firstPage = Math.Max(1, Model.Page - 2);
            var lastPage = Math.Min(Model.TotalPages, firstPage + 4);
            firstPage = Math.Max(1, lastPage - 4);
            <nav class="mt-3" aria-label="التنقل بين صفحات عملاء الاستربس">
                <ul class="pagination justify-content-center flex-wrap">
                    <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Customers" asp-route-page="1"
                           asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@Model.SearchTerm">الأولى</a>
                    </li>
                    <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Customers" asp-route-page="@(Model.Page - 1)"
                           asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@Model.SearchTerm">السابق</a>
                    </li>
                    @for (var pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Customers" asp-route-page="@pageNumber"
                               asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@Model.SearchTerm">@pageNumber</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Customers" asp-route-page="@(Model.Page + 1)"
                           asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@Model.SearchTerm">التالي</a>
                    </li>
                    <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Customers" asp-route-page="@Model.TotalPages"
                           asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@Model.SearchTerm">الأخيرة</a>
                    </li>
                </ul>
            </nav>
        }
        <p class="text-muted text-center mt-3">
            عرض @((Model.Page - 1) * Model.PageSize + 1) إلى @Math.Min(Model.Page * Model.PageSize, Model.TotalCount)
            من @Model.TotalCount عميل
        </p>
    }
    else
    {
        <div class="card">
            <div class="empty-state">
                <i class="fas fa-users-slash"></i>
                @if (string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <h4>لا يوجد عملاء استربس</h4>
                    <p class="text-muted">ابدأ بإضافة عميل جديد</p>
                    <a asp-action="CreateCustomer" class="btn btn-success mt-2">
                        <i class="fas fa-user-plus me-1"></i> إضافة عميل
                    </a>
                }
                else
                {
                    <h4>لا توجد نتائج</h4>
                    <p class="text-muted">جرّب البحث باسم أو رقم تليفون آخر.</p>
                }
            </div>
        </div>
    }
</div>
