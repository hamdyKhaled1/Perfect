@model IReadOnlyList<HagImamAccounts.ViewModels.TreasuryAccountSummaryViewModel>
@{
    ViewData["Title"] = "الخزن";
    var abuMazenAccounts = Model.Where(account =>
        account.Account == HagImamAccounts.Models.TreasuryAccount.AbuMazenCash ||
        account.Account == HagImamAccounts.Models.TreasuryAccount.AbuMazenVodafoneCash ||
        account.Account == HagImamAccounts.Models.TreasuryAccount.AbuMazenInstaPay);
    var hajjImamAccounts = Model.Where(account =>
        account.Account == HagImamAccounts.Models.TreasuryAccount.HajjImamCash ||
        account.Account == HagImamAccounts.Models.TreasuryAccount.HajjImamVodafoneCash ||
        account.Account == HagImamAccounts.Models.TreasuryAccount.HajjImamInstaPay);
    var generalAccounts = Model.Where(account =>
        account.Account == HagImamAccounts.Models.TreasuryAccount.General);
}

<div class="fade-in">
    <h3 class="fw-bold mb-4">
        <i class="fas fa-vault me-2 text-success"></i>الخزن والمحافظ
    </h3>

    @foreach (var accountGroup in new[]
    {
        (Title: "خزن ومحافظ أبو مازن", Accounts: abuMazenAccounts),
        (Title: "خزن ومحافظ الحاج إمام", Accounts: hajjImamAccounts),
        (Title: "الخزنة العمومية", Accounts: generalAccounts)
    })
    {
        <section class="mb-4">
            <h5 class="fw-bold border-bottom pb-2 mb-3">@accountGroup.Title</h5>
            <div class="row g-3">
                @foreach (var account in accountGroup.Accounts)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="card card-dashboard h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="text-muted">@account.AccountName</div>
                                        <div class="display-6 @(account.Balance < 0 ? "text-danger" : "text-success")">
                                            @account.Balance.ToString("#,##0.####")
                                        </div>
                                    </div>
                                    <span class="badge bg-secondary">@account.EntryCount حركة</span>
                                </div>
                                <a asp-action="Account" asp-route-account="@account.Account" class="btn btn-outline-success mt-3">
                                    <i class="fas fa-list me-1"></i> الحركات والتفاصيل
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }
</div>
