@model Client
@{
    ViewData["Title"] = "إضافة عميل جديد";
}

<div class="fade-in">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4 text-success">
                        <i class="fas fa-user-plus me-2"></i>إضافة عميل جديد
                    </h4>

                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">
                                <i class="fas fa-user me-1"></i>اسم العميل <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control" placeholder="أدخل اسم العميل" autofocus />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label">
                                <i class="fas fa-phone me-1"></i>رقم التليفون
                            </label>
                            <input asp-for="Phone" class="form-control" placeholder="01xxxxxxxxx" dir="ltr" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label">
                                <i class="fas fa-sticky-note me-1"></i>ملاحظات
                            </label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="ملاحظات إضافية (اختياري)"></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-success px-4">
                                <i class="fas fa-save me-1"></i> حفظ
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i> إلغاء
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
