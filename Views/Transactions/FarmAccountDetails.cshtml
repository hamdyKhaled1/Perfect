@model HagImamAccounts.ViewModels.FarmAccountLedgerViewModel
@{
    ViewData["Title"] = $"كشف حساب المزرعة - {Model.FarmName}";
}

<div class="fade-in">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h4 class="fw-bold mb-0">
            <i class="fas fa-clipboard-list me-2 text-success"></i>كشف حساب المزرعة - @Model.FarmName
        </h4>
        <div class="d-flex gap-2">
            <a asp-action="FarmMeals" asp-route-farmName="@Model.FarmName" class="btn btn-outline-success">
                <i class="fas fa-box-archive me-1"></i> الوجبات
            </a>
            <a asp-action="FarmAccounts" class="btn btn-outline-dark">
                <i class="fas fa-arrow-right me-1"></i> رجوع لحسابات المزارع
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card card-body h-100">
                <div class="text-muted small">إجمالي حساب الوجبات والإضافات</div>
                <strong class="fs-4">@((Model.TotalFarmAccount + Model.TotalAddition).ToString("#,##0.####"))</strong>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card card-body h-100">
                <div class="text-muted small">إجمالي الخصومات</div>
                <strong class="fs-4 text-danger">@Model.TotalDiscount.ToString("#,##0.####")</strong>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card card-body h-100">
                <div class="text-muted small">إجمالي التحصيل من العملاء</div>
                <strong class="fs-4 text-success">@Model.TotalCustomerCollections.ToString("#,##0.####")</strong>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card card-body h-100">
                <div class="text-muted small">الباقي للمزرعة</div>
                <strong class="fs-4 @(Model.Remaining > 0 ? "text-danger" : "text-success")">
                    @Model.Remaining.ToString("#,##0.####")
                </strong>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="fw-bold mb-3">تسجيل دفعة للمزرعة</h5>
            <form asp-action="AddFarmPayment" method="post">
                <input asp-for="NewPayment.FarmName" type="hidden" />
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label asp-for="NewPayment.Statement" class="form-label">البيان</label>
                        <input asp-for="NewPayment.Statement" class="form-control" maxlength="500" />
                        <span asp-validation-for="NewPayment.Statement" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="NewPayment.Amount" class="form-label">المبلغ المدفوع</label>
                        <input asp-for="NewPayment.Amount" type="number" min="0.01" step="0.01" class="form-control" />
                        <span asp-validation-for="NewPayment.Amount" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="NewPayment.Date" class="form-label">تاريخ الدفع</label>
                        <input asp-for="NewPayment.Date" type="date" class="form-control" />
                        <span asp-validation-for="NewPayment.Date" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label asp-for="NewPayment.TreasuryAccount" class="form-label">الدفع من خزنة</label>
                        <select asp-for="NewPayment.TreasuryAccount" class="form-select">
                            @foreach (var account in HagImamAccounts.ViewModels.FarmPaymentInputViewModel.AvailableTreasuryAccounts)
                            {
                                <option value="@account">@HagImamAccounts.Models.TreasuryEntry.GetAccountName(account)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="fas fa-plus me-1"></i> تسجيل الدفعة
                        </button>
                    </div>
                </div>
                <div asp-validation-summary="All" class="text-danger mt-2"></div>
            </form>
            @if (Model.LegacyPaid > 0)
            {
                <div class="text-muted small mt-2">
                    الدفعات القديمة @Model.LegacyPaid.ToString("#,##0.####") محفوظة كإجمالي سابق دون تاريخ تفصيلي.
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="fw-bold mb-3">تسجيل إضافة أو خصم على حساب المزرعة</h5>
            <form asp-action="AddFarmAccountAdjustment" method="post">
                <input asp-for="NewAdjustment.FarmName" type="hidden" />
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label asp-for="NewAdjustment.Statement" class="form-label">البيان</label>
                        <input asp-for="NewAdjustment.Statement" class="form-control" maxlength="500" />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="NewAdjustment.Type" class="form-label">نوع الحركة</label>
                        <select asp-for="NewAdjustment.Type" class="form-select">
                            <option value="@HagImamAccounts.Models.FarmAccountAdjustmentType.Addition">إضافة</option>
                            <option value="@HagImamAccounts.Models.FarmAccountAdjustmentType.Discount">خصم</option>
                        </select>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="NewAdjustment.Amount" class="form-label">المبلغ</label>
                        <input asp-for="NewAdjustment.Amount" type="number" min="0.01" step="0.01" class="form-control" />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="NewAdjustment.Date" class="form-label">التاريخ</label>
                        <input asp-for="NewAdjustment.Date" type="date" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="fas fa-plus me-1"></i> تسجيل الإضافة / الخصم
                        </button>
                    </div>
                </div>
                <div asp-validation-summary="All" class="text-danger mt-2"></div>
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>التاريخ</th>
                    <th>نوع الحركة</th>
                    <th>التفاصيل</th>
                    <th>على حساب المزرعة</th>
                    <th>مدفوع</th>
                    <th>الباقي بعد الحركة</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">لا توجد حركات مسجلة للمزرعة.</td>
                    </tr>
                }
                else
                {
                    @for (var index = 0; index < Model.Rows.Count; index++)
                    {
                        var row = Model.Rows[index];
                        <tr>
                            <td>@(index + 1)</td>
                            <td class="text-nowrap">@(row.Date?.ToString("dd/MM/yyyy") ?? "بدون تاريخ")</td>
                            <td>
                                <span class="badge @(row.Type == "دفعة للمزرعة" || row.Type == "مدفوع سابق غير مؤرخ" ? "bg-success" : row.Type == "خصم من حساب المزرعة" ? "bg-warning text-dark" : "bg-primary")">
                                    @row.Type
                                </span>
                            </td>
                            <td>
                                <div>@row.Statement</div>
                                @if (row.CustomerMeals.Count > 0)
                                {
                                    <details class="mt-2">
                                        <summary class="text-primary">وجبات العملاء (@row.CustomerMeals.Count)</summary>
                                        <ul class="mb-0 mt-1">
                                            @foreach (var meal in row.CustomerMeals)
                                            {
                                                <li>
                                                    @meal.Date.ToString("dd/MM/yyyy") - @meal.ClientName:
                                                    وزن @meal.NetWeight.ToString("#,##0.####")،
                                                    @meal.MealTotal.ToString("#,##0.####")
                                                </li>
                                            }
                                        </ul>
                                    </details>
                                }
                                @if (row.CustomerCollections.Count > 0)
                                {
                                    <details class="mt-2">
                                        <summary class="text-success">تحصيلات العملاء (@row.CustomerCollections.Count)</summary>
                                        <ul class="mb-0 mt-1">
                                            @foreach (var collection in row.CustomerCollections)
                                            {
                                                <li>
                                                    @collection.Date.ToString("dd/MM/yyyy") - @collection.ClientName:
                                                    @if (collection.Cash > 0)
                                                    {
                                                        <span>نقدي @collection.Cash.ToString("#,##0.####")</span>
                                                    }
                                                    @if (collection.Electronic > 0)
                                                    {
                                                        <span> إلكتروني @collection.Electronic.ToString("#,##0.####")</span>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    </details>
                                }
                            </td>
                            <td>@row.Debit.ToString("#,##0.####")</td>
                            <td class="text-success">@row.Credit.ToString("#,##0.####")</td>
                            <td class="fw-bold @(row.Balance > 0 ? "text-danger" : row.Balance < 0 ? "text-primary" : "text-success")">
                                @row.Balance.ToString("#,##0.####")
                            </td>
                            <td>
                                @if (row.Type == "دفعة للمزرعة")
                                {
                                    <div class="d-flex gap-1">
                                        <a asp-action="EditFarmPayment" asp-route-id="@row.Id" class="btn btn-sm btn-outline-primary" title="تعديل الدفعة">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form asp-action="DeleteFarmPayment" asp-route-id="@row.Id" method="post"
                                              data-confirm="هل أنت متأكد من حذف هذه الدفعة؟">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف الدفعة">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                                else if (row.Type == "إضافة على حساب المزرعة" || row.Type == "خصم من حساب المزرعة")
                                {
                                    <form asp-action="DeleteFarmAccountAdjustment" asp-route-id="@row.Id" method="post"
                                          data-confirm="هل أنت متأكد من حذف حركة الإضافة أو الخصم؟">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف الحركة">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
