@model PayrollAdvanceFormViewModel
@{
    var isNew = Model.Id == null;
    ViewData["Title"] = isNew ? "سلفة جديدة" : "تعديل سلفة";
}

<div class="fade-in">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="fas fa-hand-holding-dollar me-2 text-success"></i>
                @(isNew ? "تسجيل سلفة جديدة" : "تعديل سلفة")
            </h3>
            <div class="text-muted">تُخصم السلفة من مرتب الشهر عند ربطها به من شاشة المرتبات.</div>
        </div>
        <a asp-action="Advances" class="btn btn-outline-dark">
            <i class="fas fa-arrow-right me-1"></i> رجوع للسلف
        </a>
    </div>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="@(isNew ? "CreateAdvance" : "EditAdvance")" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <div class="col-md-6 col-lg-4">
                        <label asp-for="EmployeeId" class="form-label"></label>
                        <select asp-for="EmployeeId" class="form-select" required>
                            <option value="">اختر الموظف</option>
                            @foreach (var employee in Model.Employees)
                            {
                                <option value="@employee.Id">@employee.Name@(string.IsNullOrWhiteSpace(employee.JobTitle) ? "" : $" - {employee.JobTitle}")</option>
                            }
                        </select>
                        <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <input asp-for="Amount" type="number" min="0.0001" step="0.0001" class="form-control" />
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label asp-for="Date" class="form-label"></label>
                        <input asp-for="Date" type="date" class="form-control"
                               value="@Model.Date.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Date" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Notes" class="form-label"></label>
                        <input asp-for="Notes" class="form-control" maxlength="500" autocomplete="off" />
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="fas fa-save me-1"></i> حفظ
                    </button>
                    <a asp-action="Advances" class="btn btn-outline-secondary">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>
