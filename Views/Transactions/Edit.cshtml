@model Transaction
@{
    var isMealEntry = (ViewBag.ActiveStep as string) == "meal";
    var farmMealBatchId = ViewBag.FarmMealBatchId as int?;
    var isMohamedAbdelrahmanTreasuryOwner =
        Model.CashTreasuryAccount == TreasuryAccount.MohamedAbdelrahmanCash ||
        Model.ElectronicTreasuryAccount == TreasuryAccount.MohamedAbdelrahmanVodafoneCash ||
        Model.ElectronicTreasuryAccount == TreasuryAccount.MohamedAbdelrahmanInstaPay;
    var isAbuMazenTreasuryOwner =
        Model.CashTreasuryAccount == TreasuryAccount.AbuMazenCash ||
        Model.ElectronicTreasuryAccount == TreasuryAccount.AbuMazenVodafoneCash ||
        Model.ElectronicTreasuryAccount == TreasuryAccount.AbuMazenInstaPay;
    var isHajjImamTreasuryOwner = !isMohamedAbdelrahmanTreasuryOwner && !isAbuMazenTreasuryOwner;
    ViewData["Title"] = (isMealEntry ? "تعديل وجبة - " : "تعديل تحصيل - ") + ViewBag.ClientName;
}

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">
            <i class="fas fa-edit me-2 text-warning"></i>
            @(isMealEntry ? "تعديل وجبة - " : "تعديل تحصيل - ")
            <span class="text-warning">@ViewBag.ClientName</span>
        </h4>
        @if (farmMealBatchId.HasValue)
        {
            <a asp-action="FarmMealDetails" asp-route-id="@farmMealBatchId.Value" class="btn btn-outline-dark">
                <i class="fas fa-arrow-right me-1"></i> رجوع للتوزيع
            </a>
        }
        else
        {
            <a asp-controller="Clients" asp-action="Profile" asp-route-id="@Model.ClientId" class="btn btn-outline-dark">
                <i class="fas fa-arrow-right me-1"></i> رجوع للملف
            </a>
        }
    </div>

    <form asp-action="Edit" method="post" data-transaction-form data-active-step="@ViewBag.ActiveStep">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ClientId" />
        <input type="hidden" name="formSection" value="@(ViewBag.ActiveStep ?? "accounts")" />
        <input type="hidden" name="returnPage" value="@ViewBag.ReturnPage" />
        <input type="hidden" name="returnPageSize" value="@ViewBag.ReturnPageSize" />
        <input type="hidden" name="returnFromDate" value="@(((DateTime?)ViewBag.ReturnFromDate)?.ToString("yyyy-MM-dd"))" />
        <input type="hidden" name="returnToDate" value="@(((DateTime?)ViewBag.ReturnToDate)?.ToString("yyyy-MM-dd"))" />

        <div class="row g-4">
            @if ((ViewBag.ActiveStep as string) != "meal")
            {
            <div class="col-12" data-transaction-step="accounts">
                <div class="form-section">
                    <h5><i class="fas fa-calculator me-2"></i>الحسابات</h5>

                    <div class="mb-3">
                        <label asp-for="Date" class="form-label">التاريخ</label>
                        <input asp-for="Date" type="date" class="form-control"
                               value="@Model.Date.ToString("yyyy-MM-dd")" />
                    </div>

                    <partial name="_OldBalanceField" model="Model" />

                    <div class="row g-3">
                        <div class="col-6">
                            <div class="mb-3">
                                <label asp-for="AdditionAmount" class="form-label"></label>
                                <input asp-for="AdditionAmount" type="number" step="0.01" class="form-control calc-input"
                                       id="AdditionAmount" />
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="mb-3">
                                <label asp-for="AdditionNotes" class="form-label"></label>
                                <input asp-for="AdditionNotes" class="form-control" placeholder="سبب الإضافة" />
                                <span id="AdditionNotesValidation" class="text-danger" style="display:none">ملاحظات الإضافة مطلوبة عند إدخال مبلغ إضافة.</span>
                            </div>
                        </div>
                    </div>

                    <!-- اختيار جهة التحصيل والخزنة -->
                    <div class="mb-3 p-3 bg-light rounded-3 border">
                        <label class="form-label fw-bold d-block text-dark mb-2">
                            <i class="fas fa-vault text-success me-1"></i>تحديد الخزنة المستلمة للتحصيل:
                        </label>
                        <div class="row g-2">
                            <div class="col-12 col-md-4">
                                <input type="radio" class="btn-check" name="treasuryOwnerRadio" id="treasuryHajjImam" value="HajjImam"
                                       @(isHajjImamTreasuryOwner ? "checked" : "") />
                                <label class="btn btn-outline-success w-100 py-2 fw-bold" for="treasuryHajjImam">
                                    <i class="fas fa-user-tie me-1"></i> خزنة الحاج إمام
                                </label>
                            </div>
                            <div class="col-12 col-md-4">
                                <input type="radio" class="btn-check" name="treasuryOwnerRadio" id="treasuryAbuMazen" value="AbuMazen"
                                       @(isAbuMazenTreasuryOwner ? "checked" : "") />
                                <label class="btn btn-outline-primary w-100 py-2 fw-bold" for="treasuryAbuMazen">
                                    <i class="fas fa-user me-1"></i> خزنة أبو مازن
                                </label>
                            </div>
                            <div class="col-12 col-md-4">
                                <input type="radio" class="btn-check" name="treasuryOwnerRadio" id="treasuryMohamedAbdelrahman" value="MohamedAbdelrahman"
                                       @(isMohamedAbdelrahmanTreasuryOwner ? "checked" : "") />
                                <label class="btn btn-outline-dark w-100 py-2 fw-bold" for="treasuryMohamedAbdelrahman">
                                    <i class="fas fa-user me-1"></i> خزنة محمد عبدالرحمن
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-6">
                            <div class="mb-3">
                                <label asp-for="CashCollection" class="form-label">
                                    <i class="fas fa-hand-holding-usd me-1"></i>تحصيل نقدي
                                </label>
                                <input asp-for="CashCollection" type="number" step="0.01" class="form-control calc-input"
                                       id="CashCollection" />
                                <div class="mt-2">
                                    <label class="form-label small text-muted mb-1">
                                        <i class="fas fa-box-archive me-1"></i>خزنة الإيداع النقدي:
                                    </label>
                                    <select asp-for="CashTreasuryAccount" class="form-select form-select-sm" id="CashTreasuryAccount">
                                        <option value="@TreasuryAccount.HajjImamCash" data-owner="HajjImam">خزنة الحاج إمام (نقدي)</option>
                                        <option value="@TreasuryAccount.AbuMazenCash" data-owner="AbuMazen">خزنة أبو مازن (نقدي)</option>
                                        <option value="@TreasuryAccount.MohamedAbdelrahmanCash" data-owner="MohamedAbdelrahman">خزنة محمد عبدالرحمن (نقدي)</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="mb-3">
                                <label asp-for="ElectronicCollection" class="form-label">
                                    <i class="fas fa-credit-card me-1"></i>تحصيل إلكتروني
                                </label>
                                <input asp-for="ElectronicCollection" type="number" step="0.01" class="form-control calc-input"
                                       id="ElectronicCollection" />
                                <div class="mt-2" id="electronicAccountWrapper">
                                    <label class="form-label small text-muted mb-1">
                                        <i class="fas fa-mobile-screen-button me-1"></i>طريقة التحصيل الإلكتروني:
                                    </label>
                                    <select asp-for="ElectronicTreasuryAccount" class="form-select form-select-sm" id="ElectronicTreasuryAccount">
                                        <option value="@TreasuryAccount.HajjImamVodafoneCash" data-owner="HajjImam">فودافون كاش - الحاج إمام</option>
                                        <option value="@TreasuryAccount.HajjImamInstaPay" data-owner="HajjImam">إنستا باي - الحاج إمام</option>
                                        <option value="@TreasuryAccount.AbuMazenVodafoneCash" data-owner="AbuMazen">فودافون كاش - أبو مازن</option>
                                        <option value="@TreasuryAccount.AbuMazenInstaPay" data-owner="AbuMazen">إنستا باي - أبو مازن</option>
                                        <option value="@TreasuryAccount.MohamedAbdelrahmanVodafoneCash" data-owner="MohamedAbdelrahman">فودافون كاش - محمد عبدالرحمن</option>
                                        <option value="@TreasuryAccount.MohamedAbdelrahmanInstaPay" data-owner="MohamedAbdelrahman">إنستا باي - محمد عبدالرحمن</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">الباقي بعد التحصيل</label>
                        <div class="calculated-field-display" id="remainingAfterCollection">0</div>
                    </div>

                    <div class="row g-3">
                        <div class="col-6">
                            <div class="mb-3">
                                <label asp-for="DiscountAmount" class="form-label">
                                    <i class="fas fa-percentage me-1"></i>الخصم
                                </label>
                                <input asp-for="DiscountAmount" type="number" step="0.01" class="form-control calc-input"
                                       id="DiscountAmount" />
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="mb-3">
                                <label asp-for="DiscountNotes" class="form-label">ملاحظات الخصم</label>
                                <input asp-for="DiscountNotes" class="form-control" placeholder="سبب الخصم" />
                                <span id="DiscountNotesValidation" class="text-danger" style="display:none">ملاحظات الخصم مطلوبة عند إدخال خصم.</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label fw-bold">الإجمالي</label>
                        <div class="calculated-field-display" id="subTotal">0</div>
                    </div>
                </div>
            </div>
            }

            @if ((ViewBag.ActiveStep as string) == "meal")
            {
            <div class="col-12" data-transaction-step="meal" style="display:none">
                <div class="form-section">
                    <h5><i class="fas fa-drumstick-bite me-2"></i>الوجبة</h5>
                    <div class="alert alert-info">
                        إجمالي الحسابات المرتبط: <strong>@Model.SubTotal.ToString("#,##0.####")</strong>
                    </div>
                    <input type="hidden" asp-for="OldBalance" />

                    <div class="mb-3">
                        <label asp-for="Date" class="form-label">التاريخ</label>
                        <input asp-for="Date" type="date" class="form-control"
                               value="@Model.Date.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Date" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MealType" class="form-label">نوع الوجبة</label>
                        <input asp-for="MealType" class="form-control" maxlength="100" />
                        <span asp-validation-for="MealType" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FarmPrice" class="form-label"></label>
                        <input asp-for="FarmPrice" type="number" step="0.01" class="form-control calc-input"
                               id="FarmPrice" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="GrossWeight" class="form-label">
                            <i class="fas fa-weight-hanging me-1"></i>القائم (الوزن الإجمالي)
                        </label>
                        <input asp-for="GrossWeightExpression" type="text" class="form-control calc-input"
                               data-gross-weight-expression inputmode="decimal" placeholder="مثال: 900+15" />
                        <div class="btn-group btn-group-sm w-100 mt-1" role="group" aria-label="عمليات القائم">
                            <button type="button" class="btn btn-outline-secondary" data-expression-target="GrossWeightExpression" data-expression-operator="+">+</button>
                            <button type="button" class="btn btn-outline-secondary" data-expression-target="GrossWeightExpression" data-expression-operator="-">−</button>
                            <button type="button" class="btn btn-outline-secondary" data-expression-target="GrossWeightExpression" data-expression-operator="*">×</button>
                            <button type="button" class="btn btn-outline-secondary" data-expression-target="GrossWeightExpression" data-expression-operator="/">÷</button>
                        </div>
                        <span asp-validation-for="GrossWeightExpression" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EmptyWeightExpression" class="form-label">
                            <i class="fas fa-box me-1"></i>الفارغ
                        </label>
                        <input asp-for="EmptyWeightExpression" type="text" class="form-control calc-input"
                               data-empty-weight-expression inputmode="decimal" placeholder="مثال: 8*12" />
                        <div class="btn-group btn-group-sm w-100 mt-1" role="group" aria-label="عمليات الفارغ">
                            <button type="button" class="btn btn-outline-secondary" data-expression-target="EmptyWeightExpression" data-expression-operator="+">+</button>
                            <button type="button" class="btn btn-outline-secondary" data-expression-target="EmptyWeightExpression" data-expression-operator="-">−</button>
                            <button type="button" class="btn btn-outline-secondary" data-expression-target="EmptyWeightExpression" data-expression-operator="*">×</button>
                            <button type="button" class="btn btn-outline-secondary" data-expression-target="EmptyWeightExpression" data-expression-operator="/">÷</button>
                        </div>
                        <span asp-validation-for="EmptyWeightExpression" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="fas fa-balance-scale me-1"></i>الصافي
                        </label>
                        <div class="calculated-field-display" id="netWeight">0</div>
                    </div>

                    <hr />

                    <div class="mb-3">
                        <label asp-for="ExtraField" class="form-label"></label>
                        <input asp-for="ExtraField" type="number" step="0.01" class="form-control calc-input"
                               id="ExtraField" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="PricePerKilo" class="form-label">
                            <i class="fas fa-tag me-1"></i>سعر الكيلو
                        </label>
                           <input asp-for="PricePerKilo" type="number" step="0.01" class="form-control"
                               id="PricePerKilo" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">إجمالي الوجبة (الصافي × سعر الكيلو)</label>
                        <div class="meal-total-display" id="mealTotal">0</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold h5">إجمالي ما عليه</label>
                        <div class="small text-muted mb-1">إجمالي الحسابات: <span data-account-total>0</span></div>
                        <div class="total-due-display" id="totalDue">0</div>
                    </div>

                    <div class="mb-0">
                        <label asp-for="GeneralNotes" class="form-label">ملاحظات عامة</label>
                        <textarea asp-for="GeneralNotes" class="form-control" rows="2" placeholder="ملاحظات (اختياري)"></textarea>
                    </div>
                </div>
            </div>
            }
        </div>

        <!-- Submit Buttons -->
        <div class="d-flex justify-content-center gap-3 mt-4">
            <button type="submit" class="btn btn-warning btn-lg px-5">
                <i class="fas fa-save me-2"></i> حفظ التعديلات
            </button>
            @if (farmMealBatchId.HasValue)
            {
                <a asp-action="FarmMealDetails" asp-route-id="@farmMealBatchId.Value"
                   class="btn btn-outline-secondary btn-lg px-4">
                    <i class="fas fa-times me-1"></i> إلغاء
                </a>
            }
            else
            {
                <a asp-controller="Clients" asp-action="Profile" asp-route-id="@Model.ClientId"
                   class="btn btn-outline-secondary btn-lg px-4">
                    <i class="fas fa-times me-1"></i> إلغاء
                </a>
            }
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
