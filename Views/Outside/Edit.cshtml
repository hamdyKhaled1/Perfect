@model OutsideCustomerInputViewModel
@{
    ViewData["Title"] = "تعديل عميل خارج";
}

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">
            <i class="fas fa-edit me-2 text-warning"></i>تعديل بيانات عميل الخارج
        </h3>
        <a asp-action="Index" class="btn btn-outline-dark">
            <i class="fas fa-arrow-right me-1"></i> رجوع للقائمة
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label asp-for="Name" class="form-label">اسم العميل</label>
                        <input asp-for="Name" class="form-control" maxlength="200" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Phone" class="form-label">رقم التليفون (اختياري)</label>
                        <input asp-for="Phone" class="form-control" maxlength="20" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="fas fa-save me-1"></i> حفظ
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
