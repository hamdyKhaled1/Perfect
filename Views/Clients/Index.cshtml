@model ClientFilterViewModel
@{
    ViewData["Title"] = "العملاء";
}

<div class="fade-in">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">
            <i class="fas fa-users me-2 text-success"></i>قائمة العملاء
        </h3>
        <div class="d-flex gap-2">
            <a asp-controller="Transactions" asp-action="BulkMeal" class="btn btn-outline-success">
                <i class="fas fa-weight me-1"></i> إدخال وجبات 
            </a>
            <a asp-action="ExportExcel" class="btn btn-outline-success">
                <i class="fas fa-file-excel me-1"></i> تصدير Excel
            </a>
            <a asp-action="Create" class="btn btn-success">
                <i class="fas fa-user-plus me-1"></i> عميل جديد
            </a>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card card-dashboard border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">عدد العملاء</h6>
                            <div class="display-6 text-primary">@Model.TotalCount</div>
                        </div>
                        <i class="fas fa-users fa-2x text-primary opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-dashboard border-danger">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">إجمالي المستحقات</h6>
                            <div class="display-6 text-danger">@Model.TotalDue.ToString("#,##0.####")</div>
                        </div>
                        <i class="fas fa-coins fa-2x text-danger opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
      @*   <div class="col-md-4">
            <div class="card card-dashboard border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">إجمالي الوجبات</h6>
                            <div class="display-6 text-success">@Model.TotalTransactions</div>
                        </div>
                        <i class="fas fa-receipt fa-2x text-success opacity-50"></i>
                    </div>
                </div>
            </div>
        </div> *@
    </div>

    <!-- Search & Filter -->
    <div class="search-box">
        <form method="get" id="clientFilterForm">
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label"><i class="fas fa-search me-1"></i>بحث</label>
                <div class="input-group">
                    <input type="text" name="searchTerm" class="form-control" placeholder="ابحث بالاسم أو رقم التليفون..."
                           value="@Model.SearchTerm" />
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-search me-1"></i> بحث
                    </button>
                </div>
            </div>
            <div class="col-md-6">
                <div class="d-flex gap-2">
                    <div class="flex-fill">
                        <label class="form-label">ترتيب حسب</label>
                        <select name="sortBy" class="form-select" onchange="this.form.requestSubmit()">
                            <option value="Name" selected="@(Model.SortBy == "Name")">الاسم</option>
                            <option value="TotalDue" selected="@(Model.SortBy == "TotalDue")">إجمالي ما عليه</option>
                            <option value="LastTransaction" selected="@(Model.SortBy == "LastTransaction")">آخر وجبة</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">العملاء بالصفحة</label>
                        <select name="pageSize" class="form-select" onchange="this.form.requestSubmit()">
                            <option value="10" selected="@(Model.PageSize == 10)">10</option>
                            <option value="25" selected="@(Model.PageSize == 25)">25</option>
                            <option value="50" selected="@(Model.PageSize == 50)">50</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        </form>
    </div>

    <!-- Clients Table -->
    @if (Model.Clients.Any())
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0" id="clientsTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>اسم العميل</th>
                            <th>إجمالي ما عليه</th>
                            <th>رقم التليفون</th>
                            <th>عدد التحصيل </th>
                            <th>آخر تحصيل</th>
                            <th class="no-print">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Clients.Count; i++)
                        {
                            var client = Model.Clients[i];
                            <tr>
                                <td>@((Model.Page - 1) * Model.PageSize + i + 1)</td>
                                <td class="fw-bold">@client.Name</td>
                                <td class="client-total-due">
                                    <span class="text-danger fw-bold">
                                        @client.TotalDue.ToString("#,##0.####")
                                    </span>
                                </td>
                                <td dir="ltr" class="text-center">@(client.Phone ?? "-")</td>
                                <td>
                                    <span class="badge bg-secondary">@client.TransactionCount</span>
                                </td>
                                <td>
                                    @if (client.LastTransactionDate.HasValue)
                                    {
                                        @client.LastTransactionDate.Value.ToString("yyyy/MM/dd")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="no-print">
                                    <div class="d-flex gap-1">
                                        <a asp-action="Profile" asp-route-id="@client.Id"
                                           class="btn btn-sm btn-success btn-action" title="ملف العميل">
                                            <i class="fas fa-folder-open"></i>
                                        </a>
                                       
                                        <a asp-action="Edit" asp-route-id="@client.Id"
                                           class="btn btn-sm btn-warning btn-action" title="تعديل">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="ExportClientExcel" asp-route-id="@client.Id"
                                           class="btn btn-sm btn-outline-success btn-action" title="تنزيل Excel">
                                            <i class="fas fa-file-excel"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@client.Id" method="post"
                                              data-confirm="هل أنت متأكد من حذف العميل '@client.Name'؟"
                                              style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger btn-action" title="حذف">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalPages > 1)
        {
            var firstPage = Math.Max(1, Model.Page - 2);
            var lastPage = Math.Min(Model.TotalPages, firstPage + 4);
            firstPage = Math.Max(1, lastPage - 4);
            <nav class="mt-3" aria-label="التنقل بين صفحات العملاء">
                <ul class="pagination justify-content-center flex-wrap">
                    <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-pageSize="@Model.PageSize"
                           asp-route-searchTerm="@Model.SearchTerm" asp-route-sortBy="@Model.SortBy" aria-label="الصفحة الأولى">الأولى</a>
                    </li>
                    <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize"
                           asp-route-searchTerm="@Model.SearchTerm" asp-route-sortBy="@Model.SortBy" aria-label="الصفحة السابقة">السابق</a>
                    </li>
                    @for (var pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@pageNumber" asp-route-pageSize="@Model.PageSize"
                               asp-route-searchTerm="@Model.SearchTerm" asp-route-sortBy="@Model.SortBy">@pageNumber</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize"
                           asp-route-searchTerm="@Model.SearchTerm" asp-route-sortBy="@Model.SortBy" aria-label="الصفحة التالية">التالي</a>
                    </li>
                    <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages" asp-route-pageSize="@Model.PageSize"
                           asp-route-searchTerm="@Model.SearchTerm" asp-route-sortBy="@Model.SortBy" aria-label="الصفحة الأخيرة">الأخيرة</a>
                    </li>
                </ul>
            </nav>
        }
        <p class="text-muted text-center mt-2">
            عرض @((Model.Page - 1) * Model.PageSize + 1) إلى @Math.Min(Model.Page * Model.PageSize, Model.TotalCount)
            من @Model.TotalCount عميل
        </p>
    }
    else
    {
        <div class="card">
            <div class="empty-state">
                <i class="fas fa-users-slash"></i>
                @if (string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <h4>لا يوجد عملاء</h4>
                    <p class="text-muted">ابدأ بإضافة عملاء جدد</p>
                    <a asp-action="Create" class="btn btn-success mt-2">
                        <i class="fas fa-user-plus me-1"></i> إضافة عميل
                    </a>
                }
                else
                {
                    <h4>لا توجد نتائج</h4>
                    <p class="text-muted">لم يتم العثور على عملاء يطابقون بحثك</p>
                }
            </div>
        </div>
    }
</div>
