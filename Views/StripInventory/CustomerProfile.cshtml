@model HagImamAccounts.ViewModels.StripCustomerProfileViewModel
@{
    ViewData["Title"] = $"حساب {Model.CustomerName} - الاستربس";
    string CartonTypeName(HagImamAccounts.Models.StripCartonType cartonType) =>
        cartonType == HagImamAccounts.Models.StripCartonType.FiveKilogram ? "5 كيلو" : "900 جرام";
}

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="fas fa-user me-2 text-success"></i>@Model.CustomerName
            </h3>
            <div class="text-muted">ملف عميل الاستربس @(Model.Phone ?? string.Empty)</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="EditCustomer" asp-route-id="@Model.CustomerId" class="btn btn-warning">
                <i class="fas fa-edit me-1"></i> تعديل العميل
            </a>
            <a asp-action="Customers" class="btn btn-outline-dark">
                <i class="fas fa-arrow-right me-1"></i> رجوع لقائمة العملاء
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card card-dashboard border-success">
                <div class="card-body">
                    <div class="text-muted">كراتين 5 كيلو المستلمة من المخزن</div>
                    <div class="display-6 fw-bold">@Model.FiveKilogramBalance.ToString("#,##0") كرتونة</div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card card-dashboard border-success">
                <div class="card-body">
                    <div class="text-muted">كراتين 900 جرام المستلمة من المخزن</div>
                    <div class="display-6 fw-bold">@Model.NineHundredGramBalance.ToString("#,##0") كرتونة</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="fw-bold mb-3">تسجيل حركة للعميل</h5>
            <form asp-action="AddCustomerEntry" method="post">
                <input asp-for="NewEntry.CustomerId" type="hidden" />
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="row g-3 align-items-end">
                    <div class="col-md-2">
                        <label asp-for="NewEntry.CartonType" class="form-label">نوع الكراتين</label>
                        <select asp-for="NewEntry.CartonType" class="form-select">
                            <option value="@HagImamAccounts.Models.StripCartonType.FiveKilogram">5 كيلو</option>
                            <option value="@HagImamAccounts.Models.StripCartonType.NineHundredGram">900 جرام</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="NewEntry.Date" class="form-label">التاريخ</label>
                        <input asp-for="NewEntry.Date" type="date" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="NewEntry.Statement" class="form-label">البيان</label>
                        <input asp-for="NewEntry.Statement" class="form-control" maxlength="500" />
                        <span asp-validation-for="NewEntry.Statement" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="NewEntry.Outgoing" class="form-label">استلم من المخزن</label>
                        <input asp-for="NewEntry.Outgoing" type="number" min="0" step="1" class="form-control" />
                        <span asp-validation-for="NewEntry.Outgoing" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="NewEntry.Incoming" class="form-label">مرتجع للمخزن</label>
                        <input asp-for="NewEntry.Incoming" type="number" min="0" step="1" class="form-control" />
                        <span asp-validation-for="NewEntry.Incoming" class="text-danger small"></span>
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-success w-100" title="تسجيل الحركة">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                </div>
            </form>
            <div class="text-muted small mt-2">
                صرف الكراتين للعميل يخصم من المخزون، والمرتجع يزيده. لا يمكن صرف أكثر من رصيد المخزن أو إرجاع أكثر من رصيد العميل.
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>التاريخ</th>
                    <th>نوع الكراتين</th>
                    <th>البيان</th>
                    <th>استلم من المخزن</th>
                    <th>مرتجع للمخزن</th>
                    <th>رصيد العميل</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Entries.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">لا توجد حركات مسجلة لهذا العميل.</td>
                    </tr>
                }
                else
                {
                    @for (var index = 0; index < Model.Entries.Count; index++)
                    {
                        var entry = Model.Entries[index];
                        <tr>
                            <td>@(index + 1)</td>
                            <td>@entry.Date.ToString("dd/MM/yyyy")</td>
                            <td>@CartonTypeName(entry.CartonType)</td>
                            <td>@entry.Statement</td>
                            <td class="text-danger">@entry.Outgoing.ToString("#,##0")</td>
                            <td class="text-success">@entry.Incoming.ToString("#,##0")</td>
                            <td class="fw-bold">@entry.Balance.ToString("#,##0")</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="EditCustomerEntry" asp-route-id="@entry.Id"
                                       class="btn btn-sm btn-outline-warning" title="تعديل الحركة">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                    <form asp-action="DeleteCustomerEntry" asp-route-id="@entry.Id" method="post"
                                          data-confirm="هل أنت متأكد من حذف هذه الحركة؟">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف الحركة">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
